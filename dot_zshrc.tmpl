# ~/.zshrc — interactive shell configuration
# Modular configuration lives in ~/.config/zsh.

typeset -U path PATH
path=(
  "{{ .paths.local_bin }}"
  $path
)

# Oh My Zsh plugins must be declared before the framework loads.
export ZSH="{{ .paths.oh_my_zsh }}"
ZSH_THEME="" # Starship owns the prompt.
if [[ -r "$HOME/.config/zsh/plugins.zsh" ]]; then
  source "$HOME/.config/zsh/plugins.zsh"
fi
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

for config_file in \
  completions.zsh \
  functions.zsh \
  aliases.zsh \
  keybindings.zsh \
  tools.zsh; do
  [[ -r "$HOME/.config/zsh/$config_file" ]] &&
    source "$HOME/.config/zsh/$config_file"
done
unset config_file

export EDITOR=nvim
export VISUAL=nvim

{{- if .email }}
export EMAIL={{ .email | quote }}
{{- end }}

# Machine-local secrets are deliberately not managed by chezmoi.
[[ -r "$HOME/.config/zsh/.secrets" ]] &&
  source "$HOME/.config/zsh/.secrets"
